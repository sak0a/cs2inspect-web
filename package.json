{
  "name": "steam-service",
  "version": "1.0.0",
  "description": "Standalone SteamUser/CS2Inspect service for shared Steam account access",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun run tsc",
    "start": "node dist/index.js",
    "type-check": "bun run tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test src/**/*.test.ts",
    "test:integration": "STEAM_TEST_ENABLED=true bun test src/**/*.integration.test.ts",
    "test:all": "bun test && STEAM_TEST_ENABLED=true bun test src/**/*.integration.test.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "fastify": "^4.29.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/rate-limit": "^9.1.0",
    "cs2-inspect-lib": "^3.2.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "typescript": "^5.9.3",
    "@types/bun": "latest",
    "bun-types": "latest",
    "tsx": "^4.21.0"
  }
}
