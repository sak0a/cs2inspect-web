{
  "name": "cs2inspect-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "bun run generate && vitepress build && bun run postbuild",
    "serve": "vitepress serve",
    "preview": "vitepress preview",
    "generate": "bun run generate:api && bun run generate:llms",
    "generate:api": "bun run scripts/generate-api-docs.ts",
    "generate:llms": "bun run scripts/generate-llms-txt.ts",
    "postbuild": "bun run scripts/generate-raw-md.ts",
    "generate:types": "typedoc"
  },
  "devDependencies": {
    "mermaid": "^11.12.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "^5.3.0",
    "glob": "^11.0.0"
  }
}
