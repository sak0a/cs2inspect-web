{
  "name": "steam-service",
  "version": "1.0.0",
  "description": "Standalone SteamUser/CS2Inspect service for shared Steam account access",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun run tsc",
    "start": "node dist/index.js",
    "type-check": "bun run tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test src/**/*.test.ts",
    "test:integration": "STEAM_TEST_ENABLED=true bun test src/**/*.integration.test.ts",
    "test:all": "bun test && STEAM_TEST_ENABLED=true bun test src/**/*.integration.test.ts"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "fastify": "^5.10.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "cs2-inspect-lib": "^4.1.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "tsx": "^4.23.0"
  }
}
