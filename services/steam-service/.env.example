# Server Configuration
PORT=3211
HOST=0.0.0.0
NODE_ENV=development

# Steam Account Configuration
# Required for unmasked inspect URLs
STEAM_USERNAME=your_steam_username
STEAM_PASSWORD=your_steam_password
STEAM_API_KEY=your_steam_api_key

# API Security
# Comma-separated list of API keys for client authentication
# Each client application should have its own unique key
API_KEYS=default_api_key_here,another_key_here

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3210,http://localhost:3211

# Logging
LOG_API_REQUESTS=true
LOG_LEVEL=info

# Rate Limiting (Global)
# Maximum requests per time window
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Steam Client Configuration
# Delay between Steam API requests (milliseconds)
STEAM_RATE_LIMIT_DELAY=1500
# Maximum queue size for pending requests
STEAM_MAX_QUEUE_SIZE=100
# Request execution timeout (milliseconds)
STEAM_REQUEST_TIMEOUT=10000
# Queue timeout - how long a request can wait in queue (milliseconds)
STEAM_QUEUE_TIMEOUT=30000
