# .env file for cs2inspect-web application

########## Server Configuration ########## [REQUIRED]
# Port number on which the server will listen for incoming connections
# Default: 3210
PORT=3210

# Host address where the server will bind
# Use 127.0.0.1 for localhost only, or 0.0.0.0 to accept connections from any network interface
# Default: 127.0.0.1
HOST=127.0.0.1

########## JWT Configuration ########## [REQUIRED]
# Secret key used for generating and verifying JWT tokens for API authentication
# IMPORTANT: Use a strong, random string in production. Never commit this value to version control.
# Generate a secure random string (e.g., using: openssl rand -hex 32)
JWT_TOKEN=K32DJVFIRF93EDKKCSLFRPL2AO20E

# JWT token expiration time. Format: number followed by unit (s=seconds, m=minutes, h=hours, d=days)
# Examples: "1h", "24h", "7d", "30d"
# Default: 7d
JWT_EXPIRY=7d

########## Database Configuration ########## [REQUIRED]
# Database connection settings for MariaDB/MySQL
# Available Database Adapter: MariaDB (MySQL)

# Database server hostname or IP address
DATABASE_HOST=123.456.789.012

# Database server port number
# Default MySQL/MariaDB port: 3306
DATABASE_PORT=3306

# Database username for authentication
DATABASE_USER=csinspect

# Database password for authentication
# IMPORTANT: Use a strong password in production
DATABASE_PASSWORD=securePassword123!

# Name of the database to use
DATABASE_NAME=csinspect

# Maximum number of concurrent database connections in the connection pool
# Adjust based on your server capacity and expected load
# Default: 5
DATABASE_CONNECTION_LIMIT=5

########## Steam API Configuration ########## [REQUIRED]
# Steam Web API Key is required for:
# - User authentication via Steam OpenID
# - Fetching user profile data and inventory information
# 
# How to obtain:
# 1. Visit: https://steamcommunity.com/dev/apikey
# 2. Log in with your Steam account
# 3. Register a new API key (domain can be localhost for development)
# 4. Copy the generated key here
# 
# Note: Keep this key secure and never expose it in client-side code
STEAM_API_KEY=KDBEDI9593393EFKSKDBE3992206Z

########## Steam Account Configuration ########## [OPTIONAL]
# Steam Account credentials are used for fetching item data from SteamUser & NodeCS2 API
# This is required for the Inspect Feature to work with unmasked URLs:
# - Steam Market links
# - Player inventory links
# 
# IMPORTANT SECURITY NOTES:
# - Use a SEPARATE Steam account dedicated for this service (not your personal account)
# - Currently Steam Guard (2FA) is NOT supported - use an account without 2FA enabled
# - This account will be logged into Steam's client API - treat credentials securely
# - Consider using a Steam account with limited privileges if possible
#
# DEPRECATED: These credentials are only used if STEAM_SERVICE_URL is not set
# RECOMMENDED: Use the Steam Service Client API instead (see STEAM_SERVICE_URL below)

# Steam account username (not email)
#STEAM_USERNAME=csinspectuser

# Steam account password
# IMPORTANT: Use a strong password and never commit this to version control
#STEAM_PASSWORD=securePassword123!

########## Steam Service Client API Configuration ########## [RECOMMENDED]
# The Steam Service is a separate microservice that handles Steam API interactions
# Using this service provides several benefits:
# - Load balancing across multiple main app instances
# - Separation of concerns (Steam logic isolated from main app)
# - Easier scaling and maintenance
# - Better resource management
#
# If STEAM_SERVICE_URL is set, the main app will use this service instead of direct Steam account login
# If not set, the app will fall back to using STEAM_USERNAME/STEAM_PASSWORD (deprecated method)

# Base URL of the Steam Service Client API
# Format: http://hostname:port (no trailing slash)
# Example: http://127.0.0.1:3655 or https://steam-service.yourdomain.com
STEAM_SERVICE_URL=http://127.0.0.1:3655

# API Key for authenticating requests to the Steam Service
# This must match one STEAM_SERVICE_API_KEY configured in the Steam Service's environment variables
# IMPORTANT: Keep this key secure and never expose it in client-side code
STEAM_SERVICE_API_KEY=sKqBnyZjaWjBx62JXTzsGKq85rdLm6JKJ

########## Logging Configuration ########## [OPTIONAL]
# Enable detailed logging of API requests for debugging and monitoring
# Set to 'true' to log all API requests (useful for development and troubleshooting)
# Set to 'false' or leave unset to disable detailed request logging (recommended for production)
# Default: false
LOG_API_REQUESTS=true

########## Proxy Health Check Configuration ########## [OPTIONAL]
# Base URL used for the Image Proxy health check endpoint
# 
# When to set this:
# - If your app runs behind a reverse proxy (nginx, Apache, Cloudflare, etc.)
# - If your app is accessed via a different external URL than HOST:PORT
# - If you're using a load balancer or CDN
# 
# When to leave empty:
# - If your app is directly accessible at HOST:PORT
# - The health check will auto-derive the URL from HOST and PORT settings
#
# Format: Absolute URL with protocol (http:// or https://)
# Examples:
#   http://127.0.0.1:3210          (local development)
#   https://your-domain.com        (production with reverse proxy)
#   https://api.yourdomain.com     (subdomain setup)
#
#PROXY_HEALTH_BASE_URL=http://127.0.0.1:3210
